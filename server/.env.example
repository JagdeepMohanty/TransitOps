# Server Port (default 5001 avoids conflict with Windows service on 5000)
PORT=5001

# Environment
NODE_ENV=development

# MySQL Database connection string (Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE)
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/transitops

# JWT Authentication (at least 16 characters)
JWT_SECRET=replace_with_at_least_16_char_secure_random_secret
JWT_EXPIRES_IN=8h

# Client URL for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:5173
